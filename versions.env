# Pinned upstream revisions Integrity Fusion is built from.
# Bump these (and re-check patches/ still applies) to pick up upstream changes.

TEESIM_REPO="https://github.com/JingMatrix/TEESimulator.git"
TEESIM_REF="4f42350e8ad8d5f11111d2200f39d1d4d113a4df"
TEESIM_BRANCH="dev"

# Human-readable component version, baked into the fusion module.prop.
TEESIM_VERSION="v4.0-canary-66"

# Fingerprint half: the pinned official Play Integrity Fork release zip.
# We ship the official release binary (checksum-pinned) instead of building it:
# its gradle build needs its own toolchain matrix, and the project's release
# artifacts are the canonical distribution. GPL-3.0, same as this fusion —
# see NOTICE.md for credit and source links.
PIF_REPO="https://github.com/osm0sis/PlayIntegrityFork"
PIF_RELEASE="v18"
PIF_ZIP_URL="https://github.com/osm0sis/PlayIntegrityFork/releases/download/v18/PlayIntegrityFork-v18.zip"
PIF_ZIP_SHA256="625ebe65631f761e1521009f10a205d74255adf2e35732923d65106643cad9a6"

# Fusion version. v1.0.0 = first PUBLIC release; v1.0.0-v3.2.3 were
# internal development versions (full history in CHANGELOG.md).
# versionCode must increase on every released build —
# the CI overrides it with YYYYMMDD of the build date.
# v3.2.2 — SECURITY-RELEVANT: keybox-fetch download ladder (proxy passthrough
# + auto-probe + direct-CDN-IP via --resolve). See docs/RELEASE-NOTES-v3.2.2.md
# and docs/security-report-keybox-fetch-v3.2.2.md before touching again.
# v3.2.3 — SECURITY FIX RELEASE: wired harden-pif.sh into assemble.sh (audit C1:
# bundled autopif4 TLS-downgrade + migrate.sh eval = MITM->root RCE), masked
# device identifiers in diagnostics export (audit H1), real pre-force keybox
# backup (audit M11), probe endpoint de-third-partied (L2). Dispositions:
# docs/security-audit-20260915-response.md
FUSION_VERSION="v1.0.1"
FUSION_VERSION_CODE="20260915"
