# Shell scripts and patches must stay LF — CRLF breaks bash and git-apply on Linux CI.
*.sh       text eol=lf
*.patch    text eol=lf
*.env      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.prop     text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.json     text eol=lf
daemon     text eol=lf
*.js        text eol=lf
update-binary text eol=lf
