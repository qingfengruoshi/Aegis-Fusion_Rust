+// True when any ATTESTATION_ID_* tag rides on the request. keystore2 only adds those for an explicit
+// ID-attestation request (device-properties attestation), so the copy in generateKey is made then
+// and only then.
+bool RequestsAttestationIds(const std::vector<KeyParameter>& params) {
+  for (const auto& p : params) {
+    switch (p.tag) {
+      case Tag::ATTESTATION_ID_BRAND:
+      case Tag::ATTESTATION_ID_DEVICE:
+      case Tag::ATTESTATION_ID_PRODUCT:
+      case Tag::ATTESTATION_ID_SERIAL:
+      case Tag::ATTESTATION_ID_IMEI:
+      case Tag::ATTESTATION_ID_SECOND_IMEI:
+      case Tag::ATTESTATION_ID_MEID:
+      case Tag::ATTESTATION_ID_MANUFACTURER:
+      case Tag::ATTESTATION_ID_MODEL:
+        return true;
+      default:
+        break;
+    }
+  }
+  return false;
+}
+
+// Rewrite the request's ATTESTATION_ID_* values to the profile's before an in-process TA sees them.
+//
+// Why: keystore2 fills these tags with the REAL device's identity (Build fields + telephony ids) on
+// behalf of the caller, while our TA holds the profile's identity — the reference TA answers that
+// mismatch with ErrorCode::CANNOT_ATTEST_IDS (-66), the failure every ID-attesting app showed once
+// its package entered the scope. With the values aligned the gate passes, and the leaf attests the
+// identity the profile already carries — the resign path patches the very same values into the
+// certificate, so the request never carried a claim the answer would contradict. A tag the profile
+// has no value for is dropped: the TA then attests no id there rather than failing the whole key.
+// Requests that continue to the real HAL (patch mode, foreign attest key) must keep the real values
+// — the real TA holds the real ids and would fail on ours.
+std::vector<KeyParameter> RetargetAttestationIds(const std::vector<KeyParameter>& params,
+                                                 const AttestIdValues& ids) {
+  std::vector<KeyParameter> out;
+  out.reserve(params.size());
+  for (const auto& p : params) {
+    const std::string* v = nullptr;
+    switch (p.tag) {
+      case Tag::ATTESTATION_ID_BRAND: v = &ids.brand; break;
+      case Tag::ATTESTATION_ID_DEVICE: v = &ids.device; break;
+      case Tag::ATTESTATION_ID_PRODUCT: v = &ids.product; break;
+      case Tag::ATTESTATION_ID_SERIAL: v = &ids.serial; break;
+      case Tag::ATTESTATION_ID_IMEI: v = &ids.imei; break;
+      case Tag::ATTESTATION_ID_SECOND_IMEI: v = &ids.imei2; break;
+      case Tag::ATTESTATION_ID_MEID: v = &ids.meid; break;
+      case Tag::ATTESTATION_ID_MANUFACTURER: v = &ids.manufacturer; break;
+      case Tag::ATTESTATION_ID_MODEL: v = &ids.model; break;
+      default: break;
+    }
+    if (!v) {
+      out.push_back(p);
+      continue;
+    }
+    if (v->empty()) continue;  // profile declines this id: drop the tag, attest nothing there
+    KeyParameter q = p;
+    if (q.value.getTag() == KeyParameterValue::blob) {
+      q.value.set<KeyParameterValue::blob>(std::vector<uint8_t>(v->begin(), v->end()));
+    }
+    out.push_back(std::move(q));
+  }
+  return out;
+}
