+  [/^Rename failed: (.*)$/, "重命名失败：$1"],
+  [/^Delete failed: (.*)$/, "删除失败：$1"],
+  [/^Overwrite existing keybox "(.+)"\?$/, "覆盖已存在的密钥盒“$1”？"],
+  [/^Rename "(.+)" to:$/, "将“$1”重命名为："],
+  [/^Delete keybox "(.+)"\? This cannot be undone\.$/, "删除密钥盒“$1”？此操作无法撤销。"],
+  [/^Saved to (.*)$/, "已保存到 $1"],
+  [/^Cleared (\d+) apps?$/, "已清除 $1 个应用"],
+  [/^Target privileged uid (\d+)\?([\s\S]*)$/,
+    (m) => "要定向到特权 uid " + m[1] + " 吗？\n\n这是系统/shell uid（例如 shell、system_server），不是普通应用。仅在明确知道原因时才这样做。"],
