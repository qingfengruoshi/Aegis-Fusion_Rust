+  // keyadmin-controller
+  [/^(\d+) keys?$/, "$1 个密钥"],
+  [/^Delete (this key|\d+ keys) from keystore2\? The owning app will re-create the key \(and re-attest it\) on next use\.$/,
+    (m) => "从 keystore2 删除" + (m[1] === "this key" ? "此密钥" : " " + t(m[1])) + "？所属应用下次使用时会重新创建（并重新证明）该密钥。"],
+  [/^Deleted (\d+) keys?$/, "已删除 $1 个密钥"],
+
+  // validate.js
+  [/^Invalid app entry: (.*)$/, "无效的应用条目：$1"],
+  [/^Invalid ([^:]+): (.*)$/, "$1 无效：$2"],
+  [/^(.+) is required\.$/, "必须填写“$1”。"],
+  [/^Unsupported version \(expected (\d+)\)\.$/, "不支持的版本（应为 $1）。"],
+  [/^App entry (.+) is claimed by (\d+) profiles; it must be unique\.$/,
+    "应用条目 $1 被 $2 个配置同时使用；它必须是唯一的。"],
+  [/^Only one profile may auto-include new apps; (\d+) do\.$/,
+    "只允许一个配置开启“自动纳入新应用”；当前有 $1 个。"],
+];
+
+// ---- the translator ------------------------------------------------------
+export function t(s) {
+  if (typeof s !== "string" || !s) return s;
+  const exact = DICT[s];
+  if (exact != null) return exact;
+  for (const [re, rep] of RULES) {
+    const m = s.match(re);
+    if (m) return typeof rep === "function" ? rep(m) : s.replace(re, rep);
+  }
+  return s;
+}
