     private fun bootKeyOverride(raw: ByteArray): BootOverride? {
+        // Fusion (Aegis) compat override: a 32-byte /data/adb/teesim/bootkey.bin replaces the
+        // verified-boot key even when the TEE capture is usable. TrickyStore-style stacks pass
