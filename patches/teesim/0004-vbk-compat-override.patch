+    /** Fusion compat: read a forced verified-boot key (exactly 32 non-zero bytes) if present. */
+    private fun forcedBootKey(): ByteArray? {
+        val f = java.io.File("/data/adb/teesim/bootkey.bin")
+        if (!f.isFile || f.length() != 32L) return null
+        val v = f.readBytes()
+        return if (v.size == 32 && v.any { it.toInt() != 0 }) v else null
+    }
+
     /** A usable boot value: exactly 32 bytes and not all zero. */
     private fun isUsableBootValue(v: ByteArray?): Boolean =
         v != null && v.size == 32 && v.any { it.toInt() != 0 }
